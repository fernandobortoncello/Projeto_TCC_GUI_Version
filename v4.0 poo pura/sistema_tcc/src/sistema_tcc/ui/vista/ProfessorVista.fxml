<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- ATENÇÃO: Sem fx:controller definido aqui. Injetado via código. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #333; -fx-padding: 10;">
            <children>
                <Label text="Portal do Professor" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblNomeProfessor" style="-fx-margin-right: 20;" text="Nome do Professor" textFill="WHITE" />
                <Button onAction="#fazerLogout" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Sair" />
            </children>
        </HBox>
        <TabPane fx:id="tabPaneProfessor" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="Escolher Tema">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0">
                            <children>
                                <VBox spacing="10.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                                    <children>
                                        <Label text="Temas Propostos (Aguardando Orientador)">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>
                                        <ListView fx:id="listaTemasPropostos" prefHeight="200.0" />
                                        <Button onAction="#escolherOrientador" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Assumir Orientação" />
                                        <Label fx:id="lblStatusUC2" />
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab text="Registrar Orientação">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0">
                            <children>
                                <VBox spacing="10.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                                    <children>
                                        <Label text="Nova Sessão de Orientação">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>
                                        <Label text="Selecione o TCC:" />
                                        <ComboBox fx:id="comboTccsOrientandos" maxWidth="1.7976931348623157E308" promptText="Meus orientandos..." />

                                        <Label text="Data:" />
                                        <DatePicker fx:id="datePickerOrientacao" />

                                        <Label text="Descrição / Progresso:" />
                                        <TextArea fx:id="textAreaDescricao" prefHeight="100.0" promptText="Descreva o que foi discutido..." wrapText="true" />

                                        <Button onAction="#salvarOrientacao" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Registrar Orientação" />
                                        <Label fx:id="lblStatusUC3" textFill="#0d630d" />
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab text="Definir Banca">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0">
                            <children>
                                <VBox spacing="10.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                                    <children>
                                        <Label text="Agendamento de Banca">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>
                                        <Label text="Selecione o TCC (Pronto para defesa):" />
                                        <ComboBox fx:id="comboTccsParaBanca" maxWidth="1.7976931348623157E308" promptText="TCCs com orientações concluídas..." />

                                        <Label text="Data da Apresentação:" />
                                        <DatePicker fx:id="datePickerBanca" />

                                        <Label text="Membros da Banca (Segure Ctrl para múltiplos):" />
                                        <ListView fx:id="listaProfessoresDisponiveis" prefHeight="120.0" />

                                        <Button onAction="#onDefinirBancaClick" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Confirmar Banca" />
                                        <Label fx:id="lblStatusUC4" />
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab text="Finalizar TCC">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0">
                            <children>
                                <VBox spacing="10.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                                    <children>
                                        <Label text="Avaliação Final e ATA">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>
                                        <Label text="Selecione o TCC:" />
                                        <ComboBox fx:id="comboTccsParaFinalizar" maxWidth="1.7976931348623157E308" promptText="TCCs aguardando avaliação final..." />

                                        <Label text="Nota Final (0.0 - 10.0):" />
                                        <TextField fx:id="txtNotaFinal" maxWidth="100.0" promptText="Ex: 9.5" />

                                        <Label text="Parecer Final / Considerações:" />
                                        <TextArea fx:id="txtAnotacoesFinais" prefHeight="100.0" promptText="Comentários finais da banca..." wrapText="true" />

                                        <Button onAction="#onFinalizarTccClick" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Finalizar e Gerar ATA" />
                                        <Label fx:id="lblStatusUC5" textFill="#0d630d" />
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>